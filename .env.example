# Copy to .env (never commit). All values optional for local demo.
PORT=5000
JWT_SECRET=change-me
# MongoDB Atlas free-tier URI. If empty, an in-memory MongoDB is used (data resets on restart).
MONGODB_URI=
# Pick any one provider (Groq first, then Gemini, then OpenAI). If none is set a built-in heuristic AI is used.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
